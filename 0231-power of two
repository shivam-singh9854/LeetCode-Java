class Solution {
    public boolean isPowerOfTwo(int n) {

        char num = '1';
        int count = 0;

        if (n < 0) {
            return false;
        } 
        else {
            String binary = Integer.toBinaryString(n);

            for (int i = 0; i < binary.length(); i++) {
                if (num == binary.charAt(i)) {
                    count++;
                }
            }

            if (count == 1) {
                return true;
            } 
            else {
                return false;
            }
        }
    }
}
