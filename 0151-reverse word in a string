class Solution {
    public String reverseWords(String s) {

        String[] k = s.trim().split("\\s+");

        String result = "";

        for (int i = k.length - 1; i >= 0; i--) {

            result += k[i];

            if (i != 0) {
                result += " ";
            }
        }

        return result;
    }
}
