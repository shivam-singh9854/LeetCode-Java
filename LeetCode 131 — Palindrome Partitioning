import java.util.*;

class Solution {

    public List<List<String>> partition(String s) {
        List<List<String>> result = new ArrayList<>();

        solve(s, 0, new ArrayList<>(), result);

        return result;
    }

    public void solve(String s, int start,
                      List<String> current,
                      List<List<String>> result) {

        // Puri string complete ho gayi
        if (start == s.length()) {
            result.add(new ArrayList<>(current));
            return;
        }

        // Har possible substring try karo
        for (int end = start; end < s.length(); end++) {

            if (check(s, start, end)) {

                current.add(s.substring(start, end + 1));

                solve(s, end + 1, current, result);

                current.remove(current.size() - 1);
            }
        }
    }

    // Recursion se palindrome check
    public boolean check(String s, int left, int right) {

        if (left >= right) {
            return true;
        }

        if (s.charAt(left) != s.charAt(right)) {
            return false;
        }

        return check(s, left + 1, right - 1);
    }
}
