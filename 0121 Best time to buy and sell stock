class Solution {
    public int maxProfit(int[] arr) {

        int buy = Integer.MAX_VALUE;
        int max_profit = 0;
        int profit = 0;

        for (int i = 0; i < arr.length; i++) {

            if (arr[i] < buy) {
                buy = arr[i];
            }

            profit = arr[i] - buy;

            if (profit > max_profit) {
                max_profit = profit;
            }
        }

        return max_profit;
    }
}
