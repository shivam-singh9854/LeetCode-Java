class Solution {
    public int countPrimes(int n) {

        int primecount = 0;

        if (n <= 2) {
            return 0;
        }

        boolean[] isprime = new boolean[n];

        // 2 se n-1 tak initially true
        for (int i = 2; i < n; i++) {
            isprime[i] = true;
        }

        // Multiples ko false karo
        for (int i = 2; i * i < n; i++) {

            if (isprime[i]) {

                for (int j = i * i; j < n; j += i) {
                    isprime[j] = false;
                }
            }
        }

        // Prime numbers count karo
        for (int i = 2; i < n; i++) {

            if (isprime[i]) {
                primecount++;
            }
        }

        return primecount;
    }
}
