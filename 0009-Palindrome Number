class Solution {
    public boolean isPalindrome(int x) {
        int save = x;
        int rev2 = 0;

        while (x > 0) {
            int rev = x % 10;
            rev2 = rev2 * 10 + rev;
            x = x / 10;
        }

        if (save == rev2) {
            return true;
        } else {
            return false;
        }
    }
}
