class Solution {
    public boolean isPalindrome(String s) {

        String clean = "";
        String copy = "";

        s = s.toLowerCase();

        for (int i = 0; i < s.length(); i++) {

            if (Character.isLetterOrDigit(s.charAt(i))) {
                clean += s.charAt(i);
            }
        }

        for (int i = clean.length() - 1; i >= 0; i--) {
            copy += clean.charAt(i);
        }

        if (clean.equals(copy)) {
            return true;
        } else {
            return false;
        }
    }
}
